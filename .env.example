DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aikouch
JWT_SECRET=replace-me

# --- Cloud.ru Evolution Foundation Models (новый провайдер GigaChat API с 1 декабря 2026) ---
# Получить в https://console.cloud.ru в разделе Evolution Foundation Models:
CLOUD_RU_API_KEY=
CLOUD_RU_API_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
CLOUD_RU_MODEL=GigaChat-Max

# --- SaluteDevices / Sber GigaChat API (текущий шлюз, действует до 1 декабря 2026) ---
# Authorization Key from the GigaChat project (without the "Basic " prefix).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1/chat/completions

# Comma-separated corporate email domains.
KAZAKHTELECOM_EMAIL_DOMAINS=telecom.kz

# Still used only by speech recognition, not by text generation.
YANDEX_FOLDER_ID=
